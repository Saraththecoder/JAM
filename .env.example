# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical public origin, used for QR verification links, email links and
# cross-site request checks. No trailing slash.
NEXT_PUBLIC_APP_URL=https://letters.example.edu

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY, development uses a logged mock and production
# returns a configuration error instead of silently dropping email.
RESEND_API_KEY=
EMAIL_FROM="JAM <no-reply@aits-tpt.edu.in>"

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# Push is disabled when either key is absent.
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aits-tpt.edu.in

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# Required in production for reliable cross-instance rate limits. When absent,
# the app falls back to process-local memory and logs a warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# AI letter drafting (OpenRouter)
# ---------------------------------------------------------------------------
# Students supply their own OpenRouter key in the browser; these settings only
# control the provider endpoint and model used by the server route.
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# Android Trusted Web Activity / Play Store
# ---------------------------------------------------------------------------
# Served at /.well-known/assetlinks.json. The package name must match the
# Android application ID. Add the Play App Signing SHA-256 fingerprint after the
# first Play Console upload, plus the upload-key fingerprint for local APK tests.
# Separate multiple fingerprints with commas.
ANDROID_PACKAGE_NAME=com.aits.jam
ANDROID_SHA256_CERT_FINGERPRINTS=
